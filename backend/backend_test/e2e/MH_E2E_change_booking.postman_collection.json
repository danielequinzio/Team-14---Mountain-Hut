  "item": [
    {
      "name": "01 - Hiker changes a booking",
      "item": [
        {
          "name": "1. Changing a booking without logging in is refused",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"party_size\": 3\n}"
            }
          }
        },
        {
          "name": "2. Hiker registers a new account",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// unique email per run: a second run would otherwise answer 409",
                  "pm.collectionVariables.set(\"email\", `hiker.${Date.now()}@mail.example`);",
                  "pm.collectionVariables.set(\"password\", \"password\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 (account created)\", () => {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mario\",\n  \"surname\": \"Verdi\",\n  \"email\": \"{{email}}\",\n  \"mobile_number\": \"+39 23231341\",\n  \"notes\": \"\",\n  \"emergency_contact\": \"\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "3. Hiker logs in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Session cookie is set\", () => {",
                  "    pm.expect(pm.cookies.get(\"session\")).to.be.a(\"string\").that.is.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "4. Hiker sees the open slots and picks two of them",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const slots = pm.response.json();",
                  "",
                  "// a change is only allowed 48 hours before the slot: use slots at least 72 hours away",
                  "const farAway = (slot) => new Date(`${slot.date}T${slot.time}`).getTime() > Date.now() + 72 * 3600 * 1000;",
                  "const usable = Array.isArray(slots) ? slots.filter(farAway).sort((a, b) =>",
                  "    `${a.date}T${a.time}`.localeCompare(`${b.date}T${b.time}`)) : [];",
                  "",
                  "pm.test(\"At least two slots are more than 72 hours away (reseed the db if not)\", () => {",
                  "    pm.expect(usable.length).to.be.at.least(2);",
                  "});",
                  "",
                  "// nothing below can work without them",
                  "if (usable.length < 2) {",
                  "    postman.setNextRequest(null);",
                  "    return;",
                  "}",
                  "",
                  "// the last two slots: the booking starts on the first and is moved to the second",
                  "const slotA = usable[usable.length - 2];",
                  "const slotB = usable[usable.length - 1];",
                  "pm.collectionVariables.set(\"slotADate\", slotA.date);",
                  "pm.collectionVariables.set(\"slotATime\", slotA.time);",
                  "pm.collectionVariables.set(\"slotBDate\", slotB.date);",
                  "pm.collectionVariables.set(\"slotBTime\", slotB.time);",
                  "",
                  "pm.test(\"The two slots are different\", () => {",
                  "    pm.expect(`${slotA.date}T${slotA.time}`).to.not.eql(`${slotB.date}T${slotB.time}`);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/slot",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "slot"
              ]
            }
          }
        },
        {
          "name": "5. Hiker books the first slot for two people",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 (booking created)\", () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const booking = pm.response.json();",
                  "pm.collectionVariables.set(\"bookingId\", booking.id);",
                  "",
                  "pm.test(\"The booking is on the first slot for two people\", () => {",
                  "    pm.expect(booking.date).to.eql(pm.collectionVariables.get(\"slotADate\"));",
                  "    pm.expect(booking.time).to.eql(pm.collectionVariables.get(\"slotATime\"));",
                  "    pm.expect(booking.party_size).to.eql(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{slotADate}}\",\n  \"time\": \"{{slotATime}}\",\n  \"party_size\": 2,\n  \"requirements\": [\n    {\n      \"allergies\": false,\n      \"description\": \"2 people - vegetarian\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "6. Hiker changes the party size to four",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
