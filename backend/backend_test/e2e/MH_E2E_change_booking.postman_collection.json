    {
      "name": "03 - Less than 48 hours before the slot",
      "item": [
        {
          "name": "1. The warden looks at the tables of the hut",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const tables = pm.response.json();",
                  "",
                  "pm.test(\"The hut has at least two tables\", () => {",
                  "    pm.expect(tables).to.be.an(\"array\");",
                  "    pm.expect(tables.length).to.be.at.least(2);",
                  "});",
                  "",
                  "if (!Array.isArray(tables) || tables.length < 2) {",
                  "    postman.setNextRequest(null);",
                  "    return;",
                  "}",
                  "",
                  "pm.collectionVariables.set(\"slotTries\", 0);",
                  "pm.collectionVariables.set(\"tableA\", tables[0].id);",
                  "pm.collectionVariables.set(\"tableB\", tables[1].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tables",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tables"
              ]
            }
          }
        },
        {
          "name": "2. The warden opens a slot about a day ahead",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// a slot that starts between 3 and 40 hours from now: closed for changes (less than 48 hours),",
                  "// but still open for booking (more than 2 hours). Random, so that a second run does not overlap the first.",
                  "const hoursAhead = 3 + Math.random() * 37;",
                  "const start = new Date(Date.now() + hoursAhead * 3600 * 1000);",
                  "start.setSeconds(0, 0);",
                  "const end = new Date(start.getTime() + 90 * 60 * 1000);",
                  "pm.collectionVariables.set(\"closeStart\", start.toISOString());",
                  "pm.collectionVariables.set(\"closeEnd\", end.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// the random start can overlap a slot left by an earlier run on the same db (409): try another time",
                  "if (pm.response.code === 409 && Number(pm.collectionVariables.get(\"slotTries\") || 0) < 10) {",
                  "    pm.collectionVariables.set(\"slotTries\", Number(pm.collectionVariables.get(\"slotTries\") || 0) + 1);",
                  "    postman.setNextRequest(pm.info.requestName);",
                  "    return;",
                  "}",
                  "",
                  "pm.test(\"Status is 201 (slot created)\", () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const slot = pm.response.json();",
                  "pm.collectionVariables.set(\"closeSlotId\", slot.id);",
                  "",
                  "pm.test(\"The slot has an id\", () => {",
                  "    pm.expect(slot.id).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/slots",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "slots"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start_time\": \"{{closeStart}}\",\n  \"end_time\": \"{{closeEnd}}\"\n}"
            }
          }
        },
