                  "});",
                  "",
                  "const booking = pm.response.json();",
                  "",
                  "pm.test(\"Same booking, same slot, now for four people\", () => {",
                  "    pm.expect(booking.id).to.eql(Number(pm.collectionVariables.get(\"bookingId\")));",
                  "    pm.expect(booking.date).to.eql(pm.collectionVariables.get(\"slotADate\"));",
                  "    pm.expect(booking.time).to.eql(pm.collectionVariables.get(\"slotATime\"));",
                  "    pm.expect(booking.party_size).to.eql(4);",
                  "});",
                  "",
                  "pm.test(\"The tables seat the new party\", () => {",
                  "    const seats = booking.tables.reduce((sum, table) => sum + table.seats, 0);",
                  "    pm.expect(seats).to.eql(4);",
                  "});"
                ]
              }
            }
          ],
