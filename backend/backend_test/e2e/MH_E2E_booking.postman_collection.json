{
  "info": {
    "name": "Mountain Hut - E2E booking",
    "description": "End-to-end scenario for Mountain Hut bookings, run against the real running server.\n\nThe server needs bookable slots and no endpoint creates them, so start it on a freshly seeded db: the seed creates the slots for the day after the db is created, and a db from a previous day has none left. For example, from the backend folder:\n\n    DATABASE_URL=sqlite:////tmp/mh_e2e.db SEED_DATA=true fastapi dev app/main.py\n\nThen run the collection in order with the Collection Runner or:\n\n    newman run MH_E2E_booking.postman_collection.json\n\nEvery run registers a new hiker with a unique email and sizes the parties from the free seats, so it can be repeated on the same db until the slots fill up.\nBookings closed less than two hours before a slot are not covered here: the seeded slots are too far away, see the unit tests.\nChange `baseUrl` in the collection variables if the server is not on localhost:8000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "" },
    { "key": "slotId", "value": "" },
    { "key": "slotDate", "value": "" },
    { "key": "slotTime", "value": "" },
    { "key": "availableSeats", "value": "" },
    { "key": "tooManyPeople", "value": "" },
    { "key": "groupSlotId", "value": "" },
    { "key": "groupSlotDate", "value": "" },
    { "key": "groupSlotTime", "value": "" },
    { "key": "groupSize", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Hiker books a table",
      "description": "Story: as a hiker, I log in, pick one of the open slots and book it for my party.",
      "item": [
        {
          "name": "1. Booking without logging in is refused",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2099-01-01\",\n  \"time\": \"12:00:00\",\n  \"party_size\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": ["{{baseUrl}}"],
              "path": ["booking"]
            }
          }
        },
        {
          "name": "2. Hiker registers a new account",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// unique email per run: a second run would otherwise answer 409",
                  "pm.collectionVariables.set(\"email\", `hiker.${Date.now()}@mail.example`);",
                  "pm.collectionVariables.set(\"password\", \"password\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 (account created)\", () => {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mario\",\n  \"surname\": \"Verdi\",\n  \"email\": \"{{email}}\",\n  \"mobile_number\": \"+39 23231341\",\n  \"notes\": \"\",\n  \"emergency_contact\": \"\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": ["{{baseUrl}}"],
              "path": ["register"]
            }
          }
        },
        {
          "name": "3. Hiker logs in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Session cookie is set\", () => {",
                  "    pm.expect(pm.cookies.get(\"session\")).to.be.a(\"string\").that.is.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "4. Hiker sees the slots open for booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const slots = pm.response.json();",
                  "",
                  "pm.test(\"At least two slots are open (a db from a previous day has none: reseed it)\", () => {",
                  "    pm.expect(slots).to.be.an(\"array\");",
                  "    pm.expect(slots.length).to.be.at.least(2);",
                  "});",
                  "",
                  "// nothing below can work without slots",
                  "if (!Array.isArray(slots) || slots.length < 2) {",
                  "    postman.setNextRequest(null);",
                  "    return;",
                  "}",
                  "",
                  "pm.test(\"Every open slot has free seats\", () => {",
                  "    slots.forEach((slot) => pm.expect(slot.available_seats).to.be.above(0));",
                  "});",
                  "",
                  "// the last slot: its slot_table ids differ from the table ids, unlike the first slot's",
                  "const slot = slots[slots.length - 1];",
                  "pm.collectionVariables.set(\"slotId\", slot.id);",
                  "pm.collectionVariables.set(\"slotDate\", slot.date);",
                  "pm.collectionVariables.set(\"slotTime\", slot.time);",
                  "pm.collectionVariables.set(\"availableSeats\", slot.available_seats);",
                  "pm.collectionVariables.set(\"tooManyPeople\", slot.available_seats + 1);",
                  "",
                  "const groupSlot = slots[0];",
                  "pm.collectionVariables.set(\"groupSlotId\", groupSlot.id);",
                  "pm.collectionVariables.set(\"groupSlotDate\", groupSlot.date);",
                  "pm.collectionVariables.set(\"groupSlotTime\", groupSlot.time);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/slot",
              "host": ["{{baseUrl}}"],
              "path": ["slot"]
            }
          }
        },
        {
          "name": "5. A party of nobody is refused",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 422\", () => {",
                  "    pm.response.to.have.status(422);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{slotDate}}\",\n  \"time\": \"{{slotTime}}\",\n  \"party_size\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": ["{{baseUrl}}"],
              "path": ["booking"]
            }
          }
        },
        {
          "name": "6. A date and time with no slot is refused",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"The hiker is told the slot is not available\", () => {",
                  "    pm.expect(pm.response.json().detail).to.eql(\"Slot not available\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2099-01-01\",\n  \"time\": \"12:00:00\",\n  \"party_size\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": ["{{baseUrl}}"],
              "path": ["booking"]
            }
          }
        },
        {
          "name": "7. A party bigger than the free seats is refused",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test(\"The hiker is told there are not enough seats\", () => {",
                  "    pm.expect(pm.response.json().detail).to.eql(\"There are not enough seats for this party\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{slotDate}}\",\n  \"time\": \"{{slotTime}}\",\n  \"party_size\": {{tooManyPeople}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": ["{{baseUrl}}"],
              "path": ["booking"]
            }
          }
        },
        {
          "name": "8. Hiker books the slot for two people",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 (booking created)\", () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const booking = pm.response.json();",
                  "",
                  "pm.test(\"Body is the booking the hiker asked for\", () => {",
                  "    pm.expect(booking.id).to.be.a(\"number\");",
                  "    pm.expect(booking.date).to.eql(pm.collectionVariables.get(\"slotDate\"));",
                  "    pm.expect(booking.time).to.eql(pm.collectionVariables.get(\"slotTime\"));",
                  "    pm.expect(booking.party_size).to.eql(2);",
                  "});",
                  "",
                  "pm.test(\"The tables seat the whole party\", () => {",
                  "    const seats = booking.tables.reduce((sum, table) => sum + table.seats, 0);",
                  "    pm.expect(seats).to.eql(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{slotDate}}\",\n  \"time\": \"{{slotTime}}\",\n  \"party_size\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": ["{{baseUrl}}"],
              "path": ["booking"]
            }
          }
        },
        {
          "name": "9. Booking the same slot again is refused",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test(\"The hiker is told the booking already exists\", () => {",
                  "    pm.expect(pm.response.json().detail).to.eql(\"A booking already exists for this slot\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{slotDate}}\",\n  \"time\": \"{{slotTime}}\",\n  \"party_size\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": ["{{baseUrl}}"],
              "path": ["booking"]
            }
          }
        },
        {
          "name": "10. The slot has two free seats less",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Only the confirmed booking took seats\", () => {",
                  "    const slotId = Number(pm.collectionVariables.get(\"slotId\"));",
                  "    const before = Number(pm.collectionVariables.get(\"availableSeats\"));",
                  "    const slot = pm.response.json().find((candidate) => candidate.id === slotId);",
                  "    pm.expect(slot.available_seats).to.eql(before - 2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/slot",
              "host": ["{{baseUrl}}"],
              "path": ["slot"]
            }
          }
        }
      ]
    },
    {
      "name": "02 - A group too big for one table",
      "description": "Story: as a hiker with a big group, I book a slot where no single table fits us, and the group is split over more tables.",
      "item": [
        {
          "name": "1. Hiker looks at the tables of another slot",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const free = pm.response.json().tables.map((table) => table.seats_free);",
                  "const groupSize = Math.max(...free) + 1;",
                  "",
                  "pm.test(\"The tables together can seat a group bigger than any one of them\", () => {",
                  "    pm.expect(free.reduce((sum, seats) => sum + seats, 0)).to.be.at.least(groupSize);",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"groupSize\", groupSize);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/slot/{{groupSlotId}}",
              "host": ["{{baseUrl}}"],
              "path": ["slot", "{{groupSlotId}}"]
            }
          }
        },
        {
          "name": "2. The group is split over more tables",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 (booking created)\", () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const booking = pm.response.json();",
                  "const groupSize = Number(pm.collectionVariables.get(\"groupSize\"));",
                  "",
                  "pm.test(\"The group sits at more than one table\", () => {",
                  "    pm.expect(booking.tables.length).to.be.at.least(2);",
                  "    const numbers = booking.tables.map((table) => table.number);",
                  "    pm.expect(new Set(numbers).size).to.eql(numbers.length);",
                  "});",
                  "",
                  "pm.test(\"The tables seat the whole group\", () => {",
                  "    const seats = booking.tables.reduce((sum, table) => sum + table.seats, 0);",
                  "    pm.expect(seats).to.eql(groupSize);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{groupSlotDate}}\",\n  \"time\": \"{{groupSlotTime}}\",\n  \"party_size\": {{groupSize}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": ["{{baseUrl}}"],
              "path": ["booking"]
            }
          }
        },
        {
          "name": "3. Hiker logs out",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": ["{{baseUrl}}"],
              "path": ["logout"]
            }
          }
        }
      ]
    },
    {
      "name": "03 - Only hikers can book",
      "description": "Story: as the warden, I can't book a table: bookings are for hikers. Uses the warden from the seed data.",
      "item": [
        {
          "name": "1. Warden logs in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"luca.bonetti@rifugio.example\",\n  \"password\": \"warden\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "2. Warden trying to book is refused",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 403\", () => {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{slotDate}}\",\n  \"time\": \"{{slotTime}}\",\n  \"party_size\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": ["{{baseUrl}}"],
              "path": ["booking"]
            }
          }
        },
        {
          "name": "3. Warden logs out",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": ["{{baseUrl}}"],
              "path": ["logout"]
            }
          }
        }
      ]
    }
  ]
}