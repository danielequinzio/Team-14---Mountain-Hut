          }
        },
        {
          "name": "5. Slot A is listed for Sunday",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const slotId = Number(pm.collectionVariables.get(\"sundaySlotId\"));",
                  "",
                  "pm.test(\"The new slot is among Sunday's slots\", () => {",
                  "    pm.expect(pm.response.json().map((s) => s.id)).to.include(slotId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/slots?date={{sundayDate}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "slots"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{sundayDate}}"
                }
              ]
            }
          }
        },
        {
          "name": "6. Slot A has tables 1 to 6, all free",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const slot = pm.response.json();",
                  "const ids = JSON.parse(pm.collectionVariables.get(\"hallTableIds\"));",
                  "",
                  "pm.test(\"It is Slot A\", () => {",
                  "    pm.expect(slot.id).to.eql(Number(pm.collectionVariables.get(\"sundaySlotId\")));",
                  "    pm.expect(new Date(slot.start_time).getTime()).to.eql(new Date(pm.collectionVariables.get(\"sundayStart\")).getTime());",
                  "});",
                  "",
                  "pm.test(\"It offers tables 1 to 6\", () => {",
                  "    pm.expect(slot.tables.map((t) => t.table_id)).to.have.members(ids);",
                  "});",
                  "",
                  "pm.test(\"No seat is booked yet\", () => {",
                  "    slot.tables.forEach((t) => {",
                  "        pm.expect(t.seats_booked).to.eql(0);",
                  "        pm.expect(t.seats_free).to.be.above(0);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/slots/{{sundaySlotId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "slots",
                "{{sundaySlotId}}"
              ]
            }
          }
        }
      ]
    },
