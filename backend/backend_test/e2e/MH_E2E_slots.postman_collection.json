        {
          "name": "9. Slot B has 10 tables, all free",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const slot = pm.response.json();",
                  "const hall = JSON.parse(pm.collectionVariables.get(\"hallTableIds\"));",
                  "const outdoor = JSON.parse(pm.collectionVariables.get(\"outdoorIds\"));",
                  "",
                  "pm.test(\"It is next Sunday at 12:00\", () => {",
                  "    pm.expect(new Date(slot.start_time).getTime()).to.eql(new Date(pm.collectionVariables.get(\"nextSundayStart\")).getTime());",
                  "    pm.expect(new Date(slot.end_time).getTime()).to.eql(new Date(pm.collectionVariables.get(\"nextSundayEnd\")).getTime());",
                  "});",
                  "",
                  "pm.test(\"It offers the 6 hall tables and the 4 outdoor ones\", () => {",
                  "    pm.expect(slot.tables).to.have.lengthOf(10);",
                  "    pm.expect(slot.tables.map((t) => t.table_id)).to.have.members([...hall, ...outdoor]);",
                  "});",
                  "",
                  "pm.test(\"No seat is booked yet: the outdoor tables have all 4 seats free\", () => {",
                  "    slot.tables.forEach((t) => pm.expect(t.seats_booked).to.eql(0));",
                  "    slot.tables.filter((t) => outdoor.includes(t.table_id)).forEach((t) => pm.expect(t.seats_free).to.eql(4));",
                  "});"
                ]
              }
            }
