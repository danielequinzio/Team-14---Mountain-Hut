                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/slots/{{sundaySlotId}}/tables",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "slots",
                "{{sundaySlotId}}",
                "tables"
              ]
