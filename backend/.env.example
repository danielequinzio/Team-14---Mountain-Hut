# copy this file to backend/.env and change the values. Empty DATABASE_URL = sqlite file backend/OQM.db
DATABASE_URL=sqlite:///MountainHut.db
SECRET_KEY=dev-only-secret-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
# true = fill an empty db with sample users, tables, slots and bookings on startup
SEED_DATA=true
# comma-separated frontend origins; do not use "*" when credentials are enabled
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8080
# set to true in production when serving over HTTPS
SESSION_COOKIE_SECURE=false

# local Mailpit, the default for development. Start it with:
# docker compose -f docker/docker-compose.yml up -d
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="Mountain Hut <noreply@mountain-hut.local>"

# real emails with Gmail: use these values in .env only, never in this file
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=mountainhut14@gmail.com
# SMTP_PASSWORD=<app password>
# EMAIL_FROM="Mountain Hut <mountainhut14@gmail.com>"