# copy this file to backend/.env and change the values. Empty DATABASE_URL = sqlite file backend/OQM.db
DATABASE_URL=sqlite:///MountainHut.db
SECRET_KEY=dev-only-secret-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
# true = fill an empty db with sample users, tables, slots and bookings on startup
SEED_DATA=false